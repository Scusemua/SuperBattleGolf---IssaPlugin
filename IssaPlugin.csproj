<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>IssaPlugin</AssemblyName>
    <Product>My first plugin</Product>
    <Version>0.0.45</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>IssaPlugin</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.2.4" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DECOMPILED_SOURCE\**" />
    <Content Remove="DECOMPILED_SOURCE**" />
    <EmbeddedResource Remove="DECOMPILED_SOURCE**" />
    <None Remove="DECOMPILED_SOURCE**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DECOMPILED_SOURCE_NEW\**" />
    <Content Remove="DECOMPILED_SOURCE_NEW**" />
    <EmbeddedResource Remove="DECOMPILED_SOURCE_NEW**" />
    <None Remove="DECOMPILED_SOURCE_NEW**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="OLD_DECOMPILED_SOURCE\**" />
    <Content Remove="OLD_DECOMPILED_SOURCE**" />
    <EmbeddedResource Remove="OLD_DECOMPILED_SOURCE**" />
    <None Remove="OLD_DECOMPILED_SOURCE**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="OLDEST_DECOMPILED_SOURCE\**" />
    <Content Remove="OLDEST_DECOMPILED_SOURCE**" />
    <EmbeddedResource Remove="OLDEST_DECOMPILED_SOURCE**" />
    <None Remove="OLDEST_DECOMPILED_SOURCE**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SAMPLE_PLUGIN\**" />
    <Content Remove="SAMPLE_PLUGIN**" />
    <EmbeddedResource Remove="SAMPLE_PLUGIN**" />
    <None Remove="SAMPLE_PLUGIN**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="IssaPlugin.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SharedAssembly">
      <HintPath>Assembly\SharedAssembly.dll</HintPath>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>Assembly\Mirror.dll</HintPath>
    </Reference>
    <Reference Include="Mirror.Components">
      <HintPath>Assembly\Mirror.Components.dll</HintPath>
    </Reference>
    <Reference Include="GameAssembly">
      <HintPath>Assembly\GameAssembly.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputForUIModule">
      <HintPath>Assembly\UnityEngine.InputForUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule.dll">
      <HintPath>Assembly\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputModule.dll">
      <HintPath>Assembly\UnityEngine.InputModule.dll</HintPath>
    </Reference>
    <Reference Include="Unity.InputSystem.dll">
      <HintPath>Assembly\Unity.InputSystem.dll</HintPath>
    </Reference>
    <Reference Include="Unity.InputSystem.ForUI.dll">
      <HintPath>Assembly\Unity.InputSystem.ForUI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.LocalizationModule">
      <HintPath>Assembly\UnityEngine.LocalizationModule.dll</HintPath>
    </Reference>
    <Reference Include="Unity.Localization">
      <HintPath>Assembly\Unity.Localization.dll</HintPath>
    </Reference>
    <!-- UI assemblies used by the ModConfig integration's config UI enhancements. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>Assembly\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>Assembly\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>Assembly\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <!-- Optional soft dependency: ModConfig in-game config UI.
         Private=false so we never ship their DLL; every code path that touches
         it is gated behind a Chainloader presence check. -->
    <Reference Include="com.atomic.modconfig">
      <HintPath>Assembly\com.atomic.modconfig.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Optional interop: ItemSpawner. Referenced only to suppress its window when
         present; our spawner does not depend on it. Private=false so we never ship it. -->
    <Reference Include="com.atomic.itemspawner">
      <HintPath>Assembly\com.atomic.itemspawner.dll</HintPath>
      <Private>false</Private>
      <!-- Aliased: the mod's root namespace "ItemSpawner" collides with the base game's
           ItemSpawner type in GameAssembly. -->
      <Aliases>ItemSpawnerMod</Aliases>
    </Reference>
  </ItemGroup>
</Project>
