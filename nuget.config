<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline restore workaround.

  Microsoft Defender Network Protection blocks api.nuget.org on this machine
  (Event ID 1126, "Destination: https://api.nuget.org"), so any restore that
  contacts the live feed fails with NU1301 / TLS HandshakeFailure.

  All packages this project needs are already in the global package cache
  (~/.nuget/packages), and IssaPlugin.csproj pins them to exact versions, so
  restore can resolve entirely offline once the remote feeds are cleared.

  DELETE THIS FILE once api.nuget.org is reachable again, so that the feeds in
  IssaPlugin.csproj (<RestoreAdditionalProjectSources>) take effect normally.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
